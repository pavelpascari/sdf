---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  datePublished: Date;
  dateModified?: Date;
  tags: string[];
  author: string;
}

const { title, description, datePublished, dateModified, tags, author } = Astro.props;

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const formattedDate = formatDate(datePublished);
const formattedDateModified = dateModified ? formatDate(dateModified) : null;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://stacked-diffs-flow.com');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: datePublished.toISOString(),
  ...(dateModified && { dateModified: dateModified.toISOString() }),
  author: { '@type': 'Person', name: author },
  url: canonicalURL.href,
  keywords: tags.join(', '),
};
---

<BaseLayout title={`${title} -- SDF Blog`} description={description} ogType="article">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 overflow-hidden">

    <!-- Back link -->
    <a
      href="/blog"
      class="inline-flex items-center gap-1.5 text-sm text-fg-muted hover:text-fg transition-colors mb-8"
    >
      &larr; All posts
    </a>

    <!-- Header -->
    <header class="mb-10">
      <div class="flex flex-wrap items-center gap-2 mb-4">
        {tags.map((tag) => (
          <a
            href={`/blog/tag/${tag}`}
            class="px-2.5 py-1 rounded-full text-xs font-medium border border-rim bg-panel text-fg-muted hover:text-fg hover:border-brand/40 transition-colors"
          >
            {tag}
          </a>
        ))}
      </div>
      <h1
        class="font-display text-3xl sm:text-4xl font-bold text-fg tracking-tight leading-tight mb-4"
        style="font-family: var(--font-display); font-weight: 700;"
      >
        {title}
      </h1>
      <p class="text-fg-muted text-lg leading-relaxed mb-4">{description}</p>
      <div class="flex flex-wrap items-center gap-3 text-sm text-fg-subtle">
        <span>{author}</span>
        <span class="text-rim-bright">&middot;</span>
        <time datetime={datePublished.toISOString()}>{formattedDate}</time>
        {formattedDateModified && (
          <>
            <span class="text-rim-bright">&middot;</span>
            <span>Updated <time datetime={dateModified!.toISOString()}>{formattedDateModified}</time></span>
          </>
        )}
      </div>
    </header>

    <!-- Content -->
    <div class="prose">
      <slot />
    </div>

  </article>

  <script>
    import mermaid from 'mermaid';

    mermaid.initialize({
      startOnLoad: false,
      theme: 'dark',
      themeVariables: {
        darkMode: true,
        background: '#161627',
        primaryColor: '#6366f1',
        primaryTextColor: '#f1f5f9',
        primaryBorderColor: '#2e2e55',
        secondaryColor: '#3730a3',
        secondaryTextColor: '#f1f5f9',
        secondaryBorderColor: '#2e2e55',
        tertiaryColor: '#0f0f1a',
        tertiaryTextColor: '#f1f5f9',
        tertiaryBorderColor: '#2e2e55',
        lineColor: '#94a3b8',
        textColor: '#f1f5f9',
        mainBkg: '#161627',
        nodeBorder: '#6366f1',
        clusterBkg: '#0f0f1a',
        clusterBorder: '#2e2e55',
        titleColor: '#f1f5f9',
        edgeLabelBackground: '#161627',
        nodeTextColor: '#f1f5f9',
      },
      fontFamily: "'JetBrains Mono', 'Fira Code', monospace",
      flowchart: { curve: 'basis', padding: 20, useMaxWidth: false, htmlLabels: true },
      sequence: { mirrorActors: false, useMaxWidth: false },
    });

    async function renderMermaidBlocks() {
      // Astro/Shiki renders ```mermaid blocks as <pre> with data-language="mermaid"
      // Also handle <code class="language-mermaid"> as a fallback
      const blocks = document.querySelectorAll(
        'pre[data-language="mermaid"], pre:has(> code.language-mermaid)'
      );

      for (const block of blocks) {
        const code = block.querySelector('code');
        if (!code) continue;

        const definition = code.textContent?.trim();
        if (!definition) continue;

        const container = document.createElement('div');
        container.className = 'mermaid-diagram';

        const id = `mermaid-${Math.random().toString(36).slice(2, 9)}`;

        try {
          const { svg } = await mermaid.render(id, definition);
          container.innerHTML = svg;
          block.replaceWith(container);
        } catch (err) {
          console.warn('Mermaid render failed, keeping code block:', err);
        }
      }
    }

    // Run after DOM is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', renderMermaidBlocks);
    } else {
      renderMermaidBlocks();
    }
  </script>
</BaseLayout>
