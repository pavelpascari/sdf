---
const year = new Date().getFullYear();
---

<footer class="border-t border-rim mt-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6">

      <!-- Brand -->
      <div>
        <p class="font-display font-bold text-fg text-lg tracking-tight" style="font-weight: 700;">sdf</p>
        <p class="text-fg-subtle text-sm mt-1">Stacked Diffs Flow &mdash; MIT License</p>
      </div>

      <!-- Links -->
      <nav class="flex flex-wrap gap-x-8 gap-y-2">
        <a href="/docs" class="text-sm text-fg-muted hover:text-fg transition-colors">Docs</a>
        <a href="/docs/installation" class="text-sm text-fg-muted hover:text-fg transition-colors">Install</a>
        <a
          href="https://github.com/pavelpascari/sdf"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-fg-muted hover:text-fg transition-colors"
        >
          GitHub
        </a>
        <a
          href="https://github.com/pavelpascari/sdf/issues"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-fg-muted hover:text-fg transition-colors"
        >
          Issues
        </a>
        <a
          href="https://github.com/pavelpascari/sdf/releases"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-fg-muted hover:text-fg transition-colors"
        >
          Releases
        </a>
      </nav>

    </div>

    <div class="mt-8 pt-6 border-t border-rim flex flex-col sm:flex-row justify-between items-center gap-2">
      <p class="text-fg-subtle text-xs">
        &copy; {year} Pavel Pascari. Open source under the MIT License.
      </p>
      <p class="text-fg-subtle text-xs">
        Built with
        <a href="https://astro.build" class="text-fg-muted hover:text-fg transition-colors">Astro</a>
        &middot;
        Deployed on
        <a href="https://pages.cloudflare.com" class="text-fg-muted hover:text-fg transition-colors">Cloudflare Pages</a>
      </p>
    </div>

  </div>
</footer>
