---
interface Props {
  flags: Array<{
    name: string;
    shorthand?: string;
    type: string;
    default: string;
    description: string;
  }>;
}

const { flags } = Astro.props;
---

{flags && flags.length > 0 && (
  <table>
    <thead>
      <tr>
        <th>Flag</th>
        <th>Default</th>
        <th>Description</th>
      </tr>
    </thead>
    <tbody>
      {flags.map(f => (
        <tr>
          <td><code>{f.shorthand ? `-${f.shorthand}, ` : ''}{`--${f.name}`}</code></td>
          <td>{f.default === '' || f.default === 'false' ? '--' : <code>{f.default}</code>}</td>
          <td>{f.description}</td>
        </tr>
      ))}
    </tbody>
  </table>
)}
