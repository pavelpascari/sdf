#!/bin/sh
# Auto-format staged .go files with gofmt before committing.
# Only touches files that are already staged, preserving unstaged changes.

staged_go_files=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$')

if [ -z "$staged_go_files" ]; then
    exit 0
fi

echo "Running gofmt on staged Go files..."

for file in $staged_go_files; do
    if [ -f "$file" ]; then
        gofmt -w "$file"
        git add "$file"
    fi
done
